<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agregar Edificio</title>
</head>
<body>
  <h1>FORMULARIO PARA AGREGAR EDIFICIO</h1>
  <form action="/edificios" method="post">
    <label for="nombre">Nombre del Edificio:</label><br>
    <input type="text" name="nombre" id="nombre" placeholder="Ej: Edificio C" required style="padding: 4px; width: 250px;"><br><br>
    <input type="submit" value="GUARDAR EDIFICIO">
  </form>
  <br>
  <a href="/edificios">VOLVER AL LISTADO DE EDIFICIOS</a>
</body>
</html>
